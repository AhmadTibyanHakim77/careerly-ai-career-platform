# Copy to deploy/.env.production and replace every change-me/example value.
# Generate APP_KEY after building Dockerfile.api (see the README deployment guide).
APP_KEY=
APP_URL=https://your-domain.example
PORT=8080
SESSION_SECURE_COOKIE=true

DB_DATABASE=careerly
DB_USERNAME=careerly
DB_PASSWORD=change-me-use-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-use-a-different-long-random-password

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.your-email-provider.example
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=change-me-smtp-password
MAIL_FROM_ADDRESS=careerly@your-domain.example

# Optional: leave empty to use the built-in transparent score and skill matching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ARBEITNOW_JOBS_URL=https://www.arbeitnow.com/api/job-board-api
